{
  "manifest_version": 3,
  "name": "Stream Captions",
  "version": "1.0.0",
  "description": "Real-time subtitles for any video or music — built for Kick, works everywhere. On-device Whisper (WebGPU). Free & private.",
  "homepage_url": "https://github.com/sinafayazi/stream-captions",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Stream Captions",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kick.com/*",
        "*://*.twitch.tv/*"
      ],
      "js": ["src/content/overlay.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/capture-worklet.js",
        "vendor/transformers.min.js",
        "vendor/ort-wasm-simd-threaded.jsep.wasm",
        "vendor/ort-wasm-simd-threaded.jsep.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
