{
  "manifest_version": 3,
  "name": "Stream Captions",
  "version": "0.1.0",
  "description": "Real-time multilingual subtitles for any video or music — built for Kick, works everywhere. On-device Whisper (WebGPU). Free, private, no server.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Stream Captions"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/overlay.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/capture-worklet.js",
        "src/worker/whisper-worker.js",
        "vendor/transformers.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
